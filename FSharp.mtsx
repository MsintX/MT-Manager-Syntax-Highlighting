// F# Syntax Highlighting
// Author: MsintX
// AI Collaborator: ChatGPT (OpenAI)
{
    // 支持的后缀（扩展名来的）
    name: ["F#", ".fs", ".fsi", ".fsx", ".fsscript"]

    // 样式定义
    styles: [
        "tagNameBracket", #000000, #E8BF6A
    ]

    // 括号配对
    bracketPairs: ["()", "[]", "{}", "<>"]

    // 高亮词
    defines: [
        // 关键词
        "fsharpKeywords": {
            match: /\b(abstract|and|as|assert|base|begin|class|default|delegate|do|done|downcast|downto|elif|else|end|exception|extern|false|finally|fixed|for|fun|function|global|if|in|inherit|inline|interface|internal|lazy|let|match|member|module|mutable|namespace|new|not|null|of|open|or|override|private|public|rec|return|select|static|struct|then|to|true|try|type|upcast|use|val|void|when|while|with|yield)\b/
            0: "keyword"
        }

        // 类型系统
        "fsharpTypes": {
            match: /\b(unit|bool|byte|sbyte|int16|uint16|int32|uint32|int64|uint64|int|uint|nativeint|unativeint|float32|float|decimal|char|string|obj|exn|list|option|seq|array|Result|Choice|Async|Task|DateTime|Guid|Map|Set|List|Array|Option|String|Int32|Boolean|Double|Decimal|Console)\b/
            0: "keyword"
        }

        // FSharp.Core的
        "fsharpBuiltins": {
            match: /\b(printf|printfn|eprintf|eprintfn|sprintf|fprintf|failwith|failwithf|invalidArg|invalidOp|ignore|id|fst|snd|fst3|snd3|raise|reraise|defaultArg|nameof|box|unbox|hash|compare|string|int|float|bool|char|byte|bigint|Seq|List|Array|Option|Result)\b/
            0: "keyword"
        }

        // 类型构造器
        "fsharpConstructors": {
            match: /\b(Some|None|Ok|Error|Choice1Of2|Choice2Of2|Choice1Of3|Choice2Of3|Choice3Of3|ValueNone|ValueSome|Unchecked|Nullable|NewGuid|Empty)\b/
            0: "keyword"
        }

        // 运算符
        "fsharpOperators": {
            match: /(<\|>|<\|\||\|\|>|>>=|<<=|>>|<<|->|<-|::|<=|>=|<>|&&|\|\||\|>|<\||\+\+|--|[=+\-*\/%<>!&|^~:?]+)/
            0: "operator"
        }

        // 数字字面量
        "fsharpNumbers": {
            match: /\b(0[xX][0-9a-fA-F]+|0[oO][0-7]+|0[bB][01]+|\d+(\.\d+)?([eE][+-]?\d+)?[uyULlfFmM]?)\b/
            0: "number"
        }

        // 字符字面量 支持转义序列
        "fsharpChars": {
            start: {match: /(?<!')'/, 0: "string"}
            end: {match: /'|$/, 0: "string"}
            style: "string"
            contains: [
                {match: /\\(\\|'|"|n|r|t|b|f|v|a|[0-9]{3}|x[0-9a-fA-F]{2}|u[0-9a-fA-F]{4}|U[0-9a-fA-F]{8})/, 0: "strEscape"}
            ]
        }

        // 普通字符串 支持 "" 转义与反斜杠转义
        "fsharpStrings": {
            start: {match: /"/, 0: "string"}
            end: {match: /"|$/, 0: "string"}
            style: "string"
            contains: [
                {match: /""/, 0: "strEscape"}
                {match: /\\./, 0: "strEscape"}
            ]
        }

        // 逐字字符串（@""，仅 "" 表示引号转义）
        "fsharpVerbatimStrings": {
            start: {match: /@"/, 0: "string"}
            end: {match: /"|$/, 0: "string"}
            style: "string"
            contains: [
                {match: /""/, 0: "strEscape"}
            ]
        }

        // 三引号字符串（可跨行，无转义）
        "fsharpTripleStrings": {
            start: {match: /"""/, 0: "string"}
            end: {match: /"""/, 0: "string"}
            style: "string"
        }

        // 插值字符串
        "fsharpInterpolatedStrings": {
            start: {match: /\$"/, 0: "string"}
            end: {match: /"|$/, 0: "string"}
            style: "string"
            contains: [
                {match: /""/, 0: "strEscape"}
                {match: /\\./, 0: "strEscape"}
            ]
        }

        // 泛型参数
        "fsharpGenericParameters": {
            match: /'[A-Z][\w']*/
            0: "keyword"
        }

        // 特性/属性
        "fsharpAttributes": {
            match: /\[\<[^\]]*\>\]/
            0: "keyword"
        }

        // 类型参数上下文 用于 type/interface/inherit 等声明处的辅助关键字
        "fsharpTypeParameters": {
            match: /\b(type|interface|inherit|of|with|member|val|new)\b/
            0: "keyword"
        }

        // 函数名 后跟参数或括号的标识符
        "fsharpFunctionNames": {
            match: /\b[a-zA-Z_][\w']*(?=\s+\w|\s*\()/
            0: "keyword"
        }
    ]

    // 主包含规则 按优先级应用
    contains: [
        // 单行注释
        {match: /\/\/.*/, 0: "comment"}

        // 块注释
        {
            start: {match: /\(\*/, 0: "comment"}
            end: {match: /\*\)/, 0: "comment"}
            style: "comment"
        }

        // 字符串类（顺序影响匹配优先级：先三引号，后插值/逐字/普通/字符）
        {include: "fsharpTripleStrings"}
        {include: "fsharpInterpolatedStrings"}
        {include: "fsharpVerbatimStrings"}
        {include: "fsharpStrings"}
        {include: "fsharpChars"}

        // 数字、关键字、类型、内置函数、构造器、运算符、泛型参数、特性
        {include: "fsharpNumbers"}
        {include: "fsharpKeywords"}
        {include: "fsharpTypes"}
        {include: "fsharpBuiltins"}
        {include: "fsharpConstructors"}
        {include: "fsharpOperators"}
        {include: "fsharpGenericParameters"}
        {include: "fsharpAttributes"}
    ]
}